<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    Hazelcast 5.7.0 (latest release) bundles shaded copies of jackson-databind
    2.21.2 (com.fasterxml) and 3.1.2 (tools.jackson), which are affected by
    CVE-2026-5451x (PolymorphicTypeValidator bypass, CVSS 8.1; fixed in
    jackson-databind 2.21.4 / 3.1.4). The shaded copies are not replaceable
    from outside the Hazelcast jar and are only used for Hazelcast's internal
    serialization. Remove this suppression when a Hazelcast release bundles
    jackson-databind >= 2.21.4 / >= 3.1.4.
  -->
  <suppress>
    <notes><![CDATA[
      file name: hazelcast-5.7.0.jar (shaded jackson-databind)
    ]]></notes>
    <filePath regex="true">.*hazelcast-5\.7\.0\.jar.*</filePath>
    <cve>CVE-2026-54512</cve>
    <cve>CVE-2026-54513</cve>
    <cve>CVE-2026-54514</cve>
    <cve>CVE-2026-54515</cve>
    <cve>CVE-2026-54516</cve>
    <cve>CVE-2026-54517</cve>
    <cve>CVE-2026-54518</cve>
  </suppress>
</suppressions>
