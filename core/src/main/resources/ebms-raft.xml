<!--
  JGroups stack for jgroups-raft leader election in EbMS.

  Uses TCP + TCPPING (container/firewall friendly). Override the following
  system properties to scale beyond a single node:

    -Djgroups.bind_addr=<host-ip>
    -Djgroups.tcp.port=7800
    -Djgroups.raft.id=node1
    -Djgroups.raft.members=node1,node2,node3
    -Djgroups.tcpping.initial_hosts=host1[7800],host2[7800],host3[7800]
    -Djgroups.raft.log_dir=./raft-log

  Defaults configure a single-node cluster that immediately self-elects as
  leader, so a stand-alone deployment works out of the box.
-->
<config xmlns="urn:org:jgroups"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd">

    <TCP
            bind_addr="${jgroups.bind_addr:127.0.0.1}"
            bind_port="${jgroups.tcp.port:7800}"
            recv_buf_size="5M"
            send_buf_size="5M"
            sock_conn_timeout="300"
            thread_pool.min_threads="2"
            thread_pool.max_threads="100"
            thread_pool.keep_alive_time="5000"/>

    <TCPPING
            initial_hosts="${jgroups.tcpping.initial_hosts:127.0.0.1[7800]}"
            port_range="2"/>

    <MERGE3 max_interval="30000" min_interval="10000"/>
    <FD_SOCK/>
    <FD_ALL3/>
    <VERIFY_SUSPECT timeout="1500"/>
    <pbcast.NAKACK2
            xmit_interval="500"
            xmit_table_num_rows="100"
            xmit_table_msgs_per_row="2000"
            xmit_table_max_compaction_time="30000"
            use_mcast_xmit="false"
            discard_delivered_msgs="true"/>
    <UNICAST3
            xmit_interval="500"
            xmit_table_num_rows="100"
            xmit_table_msgs_per_row="2000"
            xmit_table_max_compaction_time="60000"
            conn_expiry_timeout="0"/>
    <pbcast.STABLE desired_avg_gossip="50000" max_bytes="4M"/>
    <raft.NO_DUPES/>
    <pbcast.GMS print_local_addr="true" join_timeout="2000"/>
    <UFC max_credits="2M" min_threshold="0.4"/>
    <MFC max_credits="2M" min_threshold="0.4"/>
    <FRAG4 frag_size="60K"/>

    <raft.ELECTION/>
    <raft.RAFT
            members="${jgroups.raft.members:node1}"
            raft_id="${jgroups.raft.id:node1}"
            log_dir="${jgroups.raft.log_dir:./raft-log}"/>
    <raft.REDIRECT/>
    <raft.CLIENT bind_addr="0.0.0.0"/>
</config>
